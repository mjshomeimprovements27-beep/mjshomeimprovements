    if(!v) return;
    var id = parseInt(v,10);
    var found = rows.some(function(j){ return j.id===id; });
    if(!found){ toast("Job #"+id+" not found"); return; }
    if(c.assignments.some(function(a){ return a.jobId===id; })){ toast(c.name+" is already on Job #"+id); return; }
    api("assignCrew",{ name:c.name, jobId:id }).then(function(){
      toast(c.name+" assigned to Job #"+id);
      aTab("crew", document.querySelectorAll(".atabs button")[7]);
    });
  });
}
function setWage(i){
  var c = CREW[i];
  var v = prompt("Hourly wage for "+c.name+" (numbers only):", c.wage||"");
  if(v===null) return;
  api("setWage",{ name:c.name, wage:parseFloat(v)||0 }).then(function(){
    toast(c.name+" → $"+(parseFloat(v)||0)+"/hr");
    aTab("crew", document.querySelectorAll(".atabs button")[7]);
  });
}
function submitHours(i, jobId){
  var c = CREW[i];
  var inp = $("hrs-"+i+"-"+jobId);
  var h = parseFloat(inp && inp.value);
  if(!h || h<=0){ toast("Enter hours first"); return; }
  if(!c.wage){ toast("Set "+c.name+"'s hourly wage first (click edit)"); return; }
  api("submitHours",{ name:c.name, jobId:jobId, hours:h }).then(function(r){
    toast("Logged "+h+" hrs for "+c.name+" — owed "+money(r.owed)+", added to Job #"+jobId+" labor cost");
    aTab("crew", document.querySelectorAll(".atabs button")[7]);
  });
}

/* =========================================================
   PAYROLL — weekly W-2 checks (direct deposit amounts to
   record + pay stubs). Employer writes/sends checks manually.
   ========================================================= */
var payWeekRef = null;
var payCache = null;
function money2(n){ return "$" + (Number(n)||0).toFixed(2); }
function weekStartOf(d){ var x=new Date(d); x.setHours(0,0,0,0); x.setDate(x.getDate()-x.getDay()); return x; }
function isoDate(d){ return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0"); }
function payRowsFor(r, start){
  var end = start.getTime()+7*864e5;
  var byName = {};
  (r.hours||[]).forEach(function(h){
    var t = new Date(h.ts || h.Timestamp || "");
    if(t.getTime()>=start.getTime() && t.getTime()<end && t.getTime()){
      var n = h.name || h.CrewName;
      byName[n] = (byName[n]||0) + (Number(h.hours!=null?h.hours:h.Hours)||0);
    }
  });
  return (r.crew||[]).map(function(c){
    var hours = byName[c.name]||0;
    if(!hours) return null;
    var gross = hours*c.wage;
    var fica = gross*0.0765;
    var fed = gross*(Number(r.cfg&&r.cfg.fed)||0);
    var mn = gross*(Number(r.cfg&&r.cfg.mn)||0);
    var employer = gross*(0.0765+(Number(r.cfg&&r.cfg.suta)||0)+(Number(r.cfg&&r.cfg.futa)||0));
    return { name:c.name, wage:c.wage, type:c.type||"W-2 Employee", hours:hours,
      gross:gross, fica:fica, fed:fed, mn:mn, net:gross-fica-fed-mn, employer:employer };
  }).filter(Boolean);
}
function payrollHTML(r){
  if(!payWeekRef) payWeekRef = weekStartOf(new Date());
  var start = payWeekRef, ws = isoDate(start);
  var endD = new Date(start.getTime()+6*864e5);
  var list = payRowsFor(r, start);
  var paidMap = {};
  (r.paid||[]).forEach(function(p){ if(String(p.WeekStart).slice(0,10)===ws) paidMap[p.Name]=p; });
  payCache = { list:list, ws:ws, r:r };
  var tH=0,tG=0,tN=0,tE=0;
  list.forEach(function(x){ tH+=x.hours; tG+=x.gross; tN+=x.net; tE+=x.employer; });
  var range = (start.getMonth()+1)+"/"+start.getDate()+" – "+(endD.getMonth()+1)+"/"+endD.getDate()+"/"+endD.getFullYear();
  var fedPct = ((Number(r.cfg&&r.cfg.fed)||0)*100), mnPct = ((Number(r.cfg&&r.cfg.mn)||0)*100);
  return '<h2 style="color:#fff;font-size:20px;margin:6px 0 14px">Payroll — weekly W-2 checks</h2>'+
    '<div class="grow" style="margin-bottom:14px;align-items:center">'+
    '<button class="btn btn-sm btn-dark" onclick="payWeekPrev()">◀ Prev week</button>'+
    '<b style="color:#fff;font-size:15px;margin:0 12px">'+range+'</b>'+
    '<button class="btn btn-sm btn-dark" onclick="payWeekNext()">Next week ▶</button>'+
    '<button class="btn btn-sm" style="margin-left:auto" onclick="printAllStubs()">🖨 Print all stubs for week</button></div>'+
    '<div class="kpis">'+kpi("Hours",tH.toFixed(1))+kpi("Gross payroll",money2(tG))+
    kpi("Checks to write (net)",money2(tN))+kpi("Employer taxes",money2(tE))+'</div>'+
    '<div class="panel" style="margin-top:14px"><b style="color:#fff;font-size:13px">Withholding rates</b>'+
    '<div class="grow" style="margin-top:8px;flex-wrap:wrap;gap:10px;font-size:13px;color:#cbd5e1">'+
    '<span>Federal income % <input id="pay-fed" type="number" step="0.5" min="0" style="width:70px" value="'+fedPct+'"></span>'+
    '<span>MN income % <input id="pay-mn" type="number" step="0.5" min="0" style="width:70px" value="'+mnPct+'"></span>'+
    '<button class="btn btn-sm" onclick="saveWH()">Save</button>'+
    '<span style="color:#64748b">FICA 7.65% fixed · employer adds FICA 7.65% + SUTA 3% + FUTA 0.6% (set in sheet Config)</span></div></div>'+
    (list.length ?
    '<div class="panel" style="overflow-x:auto;margin-top:14px"><table><tr><th>Employee (W-2)</th><th>Hours</th><th>Rate</th><th>Gross</th><th>Fed W/H</th><th>MN W/H</th><th>FICA 7.65%</th><th>Net — check to write</th><th>Status</th><th></th></tr>'+
    list.map(function(x,i){
      var p = paidMap[x.name];
      return '<tr><td><b>'+esc(x.name)+'</b></td><td>'+x.hours.toFixed(1)+'</td><td>'+money2(x.wage)+'</td>'+
      '<td>'+money2(x.gross)+'</td><td>'+money2(x.fed)+'</td><td>'+money2(x.mn)+'</td><td>'+money2(x.fica)+'</td>'+
      '<td><b style="color:#6ee7b7">'+money2(x.net)+'</b></td>'+
      '<td>'+(p ? '✅ Paid'+(p.CheckNo?' — check #'+esc(p.CheckNo):'')+' · '+esc(String(p.PaidDate).slice(0,10)) : '<span style="color:#fbbf24">Not paid</span>')+'</td>'+
      '<td><button class="btn btn-sm btn-dark" onclick="printStub('+i+')">Stub</button> '+
      (p ? '' : '<button class="btn btn-sm" onclick="recordPay('+i+')">Record check sent</button>')+'</td></tr>';
    }).join("")+'</table>'+
    '<p style="color:#94a3b8;font-size:12px;margin:10px 0 0">Net amounts are what to pay each employee (direct deposit or manual check). "Record check sent" logs the payment, feeds YTD on stubs, and adds employer taxes to the Taxes page.</p></div>'
    : '<div class="panel" style="margin-top:14px;color:#94a3b8">No hours logged for this week yet — log hours on the Crew tab, or ◀ to a past week.</div>');
}
function payWeekPrev(){ payWeekRef = new Date(payWeekRef.getTime()-7*864e5); refreshPay(); }
function payWeekNext(){ payWeekRef = new Date(payWeekRef.getTime()+7*864e5); refreshPay(); }
function refreshPay(){ api("payroll").then(function(r){ $("a-content").innerHTML=payrollHTML(r); }); }
function saveWH(){
  var f = parseFloat($("pay-fed").value)||0, m = parseFloat($("pay-mn").value)||0;
  Promise.all([
    api("setConfig",{ key:"fed", value:(f/100) }),
    api("setConfig",{ key:"mn", value:(m/100) })
  ]).then(function(){ toast("Withholding rates saved"); refreshPay(); });
}
function recordPay(i){
  var x = payCache.list[i];
  var chk = prompt("Check / deposit reference # for "+x.name+" (optional):","");
  api("payEmployee",{ weekStart:payCache.ws, name:x.name, hours:x.hours, gross:x.gross,
    fed:x.fed, mn:x.mn, fica:x.fica, net:x.net, employer:x.employer, checkNo:(chk||"") })
  .then(function(){
    toast(x.name+" — recorded "+money2(x.net)+" net · write check"+(chk?" #"+chk:"")+" · stub ready");
    refreshPay();
  });
}
function ytdFor(name, ws, paid){
  var y = { hours:0, gross:0, fed:0, mn:0, fica:0, net:0, employer:0 };
  (paid||[]).forEach(function(p){
    if(p.Name===name && String(p.WeekStart).slice(0,10)<=ws){
      y.hours += Number(p.Hours)||0; y.gross += Number(p.Gross)||0;
      y.fed += Number(p.FedWH)||0; y.mn += Number(p.MNWH)||0; y.fica += Number(p.FICA)||0;
      y.net += Number(p.Net)||0; y.employer += Number(p.EmployerCost)||0;
    }
  });
  return y;
}
function payStubDoc(x, ctx, ytd, checkNo, payDate){
  var start = new Date(ctx.ws+"T12:00:00");
  var endD = new Date(start.getTime()+6*864e5);
  var range = (start.getMonth()+1)+"/"+start.getDate()+" – "+(endD.getMonth()+1)+"/"+endD.getDate()+"/"+endD.getFullYear();
  var totDed = x.fed+x.mn+x.fica;
  return letterhead()+
    '<div class="doc-title">EARNINGS STATEMENT</div>'+
    '<div class="meta"><div><b>Employee</b>'+esc(x.name)+'<br><b>Classification</b>Part-time employee (W-2)</div>'+
    '<div style="text-align:right"><b>Pay period</b>'+range+'<br><b>Pay date</b>'+esc(payDate)+' · <b>Check #</b>'+esc(checkNo||"—")+'</div></div>'+
    '<table><tr><th>Earnings</th><th class="r">Hours</th><th class="r">Rate</th><th class="r">Amount</th></tr>'+
    '<tr><td>Hourly wages</td><td class="r">'+x.hours.toFixed(1)+'</td><td class="r">'+money2(x.wage)+'</td><td class="r">'+money2(x.gross)+'</td></tr></table>'+
    '<table><tr><th>Deductions</th><th class="r">Amount</th><th class="r">YTD</th></tr>'+
    '<tr><td>Federal income tax withheld</td><td class="r">'+money2(x.fed)+'</td><td class="r">'+money2(ytd.fed)+'</td></tr>'+
    '<tr><td>Minnesota income tax withheld</td><td class="r">'+money2(x.mn)+'</td><td class="r">'+money2(ytd.mn)+'</td></tr>'+
    '<tr><td>FICA (Social Security + Medicare 7.65%)</td><td class="r">'+money2(x.fica)+'</td><td class="r">'+money2(ytd.fica)+'</td></tr>'+
    '<tr><td><b>Total deductions</b></td><td class="r"><b>'+money2(totDed)+'</b></td><td class="r"></td></tr></table>'+
    '<table class="tot"><tr><td class="r">Gross pay</td><td class="r">'+money2(x.gross)+'</td></tr>'+
    '<tr><td class="r">Total deductions</td><td class="r">−'+money2(totDed)+'</td></tr>'+
    '<tr><td class="r g">NET PAY</td><td class="r g">'+money2(x.net)+'</td></tr></table>'+
    '<table><tr><th>Year to date</th><th class="r">Hours</th><th class="r">Gross</th><th class="r">Deductions</th><th class="r">Net pay</th></tr>'+
    '<tr><td>'+new Date().getFullYear()+' totals</td><td class="r">'+(ytd.hours+x.hours).toFixed(1)+'</td><td class="r">'+money2(ytd.gross+x.gross)+'</td>'+
    '<td class="r">'+money2(ytd.fed+ytd.mn+ytd.fica+totDed)+'</td><td class="r">'+money2(ytd.net+x.net)+'</td></tr></table>'+
    '<div class="notes"><b>Employer-paid (not deducted from employee):</b> FICA 7.65% + MN SUTA + federal FUTA = '+money2(x.employer)+' this period.'+
    ' These flow to Schedule C line 23 and Form 941 deposits.<br>'+
    'Employee is classified part-time W-2; this statement is not a W-2. Keep with payroll records.</div>';
}
function printStub(i){
  var x = payCache.list[i];
  var p = {};
  (payCache.r.paid||[]).forEach(function(q){ if(q.Name===x.name && String(q.WeekStart).slice(0,10)===payCache.ws) p=q; });
  var ytd = ytdFor(x.name, payCache.ws, payCache.r.paid);
  docWindow(payStubDoc(x, payCache, ytd, p.CheckNo||"", p.PaidDate ? new Date(p.PaidDate).toLocaleDateString() : "—"), "Pay stub — "+x.name);
}
function printAllStubs(){
  if(!payCache || !payCache.list.length){ toast("No hours this week to stub"); return; }
  var parts = payCache.list.map(function(x){
    var p = {};
    (payCache.r.paid||[]).forEach(function(q){ if(q.Name===x.name && String(q.WeekStart).slice(0,10)===payCache.ws) p=q; });
    var ytd = ytdFor(x.name, payCache.ws, payCache.r.paid);
    return payStubDoc(x, payCache, ytd, p.CheckNo||"", p.PaidDate ? new Date(p.PaidDate).toLocaleDateString() : "—")+
      '<div style="page-break-after:always"></div>';
  });
  docWindow(parts.join(""), "Pay stubs — week of "+payCache.ws);
}

/* =========================================================
   BUSINESS EXPENSES — not tied to jobs (tools, insurance,
   ads, fees…) → Schedule C line 27a + sales tax paid.
   ========================================================= */
var EXP_CATS = ["Tools / Equipment","Vehicle / Fuel (non-job)","Insurance","Advertising / Marketing","Phone / Internet","Office / Supplies","Professional Fees","Licenses / Permits","Rent / Storage","Other"];
function expDed(x){ return x.Deductible==="Yes" || x.Deductible===true; }
function expensesHTML(rows){
  var tot=0,ded=0,st=0;
  rows.forEach(function(x){ var a=Number(x.Amount)||0; tot+=a; st+=Number(x.SalesTaxPaid)||0; if(expDed(x)) ded+=a; });
  var today = new Date().toLocaleDateString();
  return '<h2 style="color:#fff;font-size:20px;margin:6px 0 14px">Business expenses (non-job)</h2>'+
    '<div class="kpis">'+kpi("Total spent",money2(tot))+kpi("Tax-deductible",money2(ded))+kpi("Sales tax paid",money2(st))+'</div>'+
    '<div class="panel" style="margin-top:14px"><b style="color:#fff;font-size:13px">Add an expense</b>'+
    '<div class="mrow-grid" style="margin-top:10px">'+
    '<div class="mrow"><label>Date</label><input id="exp-date" type="date" value="'+today+'"></div>'+
    '<div class="mrow"><label>Category</label><select id="exp-cat">'+EXP_CATS.map(function(c){ return '<option>'+esc(c)+'</option>'; }).join("")+'</select></div>'+
    '<div class="mrow"><label>Vendor</label><input id="exp-vendor" placeholder="Home Depot…"></div>'+
    '<div class="mrow"><label>Description</label><input id="exp-desc" placeholder="Chainsaw repair"></div>'+
    '<div class="mrow"><label>Amount (before tax)</label><input id="exp-amt" type="number" min="0" step="0.01" placeholder="0.00"></div>'+
    '<div class="mrow"><label>Sales tax paid</label><input id="exp-st" type="number" min="0" step="0.01" placeholder="0.00"></div>'+
    '<div class="mrow"><label>Payment method</label><select id="exp-method"><option>Cash</option><option>Check</option><option>Card</option><option>ACH / Bank</option></select></div>'+
    '<div class="mrow"><label>Tax-deductible?</label><select id="exp-ded"><option value="yes">Yes — count on Schedule C</option><option value="no">No</option></select></div>'+
    '</div><button class="btn" style="margin-top:10px" onclick="addExpense()">Add expense</button></div>'+
    '<div class="panel" style="overflow-x:auto;margin-top:14px"><table><tr><th>ID</th><th>Date</th><th>Category</th><th>Vendor</th><th>Description</th><th>Amount</th><th>Sales tax</th><th>Method</th><th>Deductible</th><th></th></tr>'+
    (rows.length ? rows.slice().reverse().map(function(x){
      return '<tr><td>'+esc(x.ID)+'</td><td>'+esc(String(x.Date).slice(0,10))+'</td><td>'+esc(x.Category)+'</td><td>'+esc(x.Vendor)+'</td>'+
      '<td>'+esc(x.Description)+'</td><td><b>'+money2(x.Amount)+'</b></td><td>'+money2(x.SalesTaxPaid)+'</td><td>'+esc(x.Method)+'</td>'+
      '<td>'+(expDed(x)?'✅':'—')+'</td>'+
      '<td><button class="btn btn-sm btn-dark" onclick="delExpense(\''+esc(x.ID)+'\')">Delete</button></td></tr>';
    }).join("") : '<tr><td colspan="10" style="color:#64748b">No business expenses yet — add tools, insurance, ads, fees and anything else not billed to a job.</td></tr>')+'</table>'+
    '<p style="color:#94a3b8;font-size:12px;margin:10px 0 0">Deductible expenses subtract from profit on the Finances page and appear on Schedule C line 27a on the Taxes page. Sales tax paid is tracked for records.</p></div>';
}
function addExpense(){
  var amt = parseFloat($("exp-amt").value);
  if(!amt || amt<=0){ toast("Enter the amount first"); return; }
  api("addExpense",{
    date: $("exp-date").value || new Date().toLocaleDateString(),
    category: $("exp-cat").value,
    vendor: $("exp-vendor").value || "",
    description: $("exp-desc").value || "",
    amount: amt,
    salesTax: parseFloat($("exp-st").value)||0,
    method: $("exp-method").value,
    deductible: $("exp-ded").value==="yes"
  }).then(function(){ toast("Expense recorded"); api("expenses").then(function(rows){ $("a-content").innerHTML=expensesHTML(rows); }); });
}
function delExpense(id){
  api("delExpense",{ id:id }).then(function(){ toast("Expense deleted"); api("expenses").then(function(rows){ $("a-content").innerHTML=expensesHTML(rows); }); });
}
</script>
</body>
</html>
