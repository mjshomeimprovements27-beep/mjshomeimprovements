<script>
/* =========================================================
   CONFIG — set this to your Apps Script Web App URL after
   deploying (Extensions → Apps Script → Deploy → Web app).
   Until set, the site runs in demo mode with sample data.
   ========================================================= */
var API_URL = ""; // e.g. "https://script.google.com/macros/s/AKfyc.../exec"
var FONT_THEME = 0; // 0=Inter · 1=Lora/Playfair · 2=Mulish · 3=Raleway · 4=Work Sans

function setFont(n){
  var v = (n==="init") ? (localStorage.getItem("fontPreview")||String(FONT_THEME)) : n;
  document.body.setAttribute("data-font", v);
  if(n!=="init") localStorage.setItem("fontPreview", v);
}
setFont("init");

var SERVICES = [
  ["Mowing","Weekly or biweekly mowing, trimming, and blow-down."],
  ["Weeding / Spraying","Bed weeding and spot spraying to keep beds and drives clean."],
  ["Mulching","Mulch delivery and spread — freshen beds in one visit."],
  ["Gutter Cleaning","Gutter cleaning and downspout flush."],
  ["Minor Tree Work","Trimming, small removals, and limb cleanup."],
  ["Staining / Painting","Decks, fences, and exterior wood staining and painting."],
  ["Power Washing","Siding, driveways, patios, and walkways."],
  ["Sod / Grass Seeding","New lawns and patch repair."],
  ["Window Cleaning","Interior & exterior window washing."],
  ["Snow Removal","Driveways and walkways, on-call or contract."],
  ["Patios / Retaining Walls","Paver patios, retaining walls, and hardscape installs."],
  ["Landscaping & Design","Bed design, plants, and full landscape installs."],
  ["Yard Maintenance","Ongoing upkeep — cleanup, pruning, and seasonal care."]
];
var CREW = [
  /* photo: put the employee photo filename here when you send them,
     e.g. photo:"matt.jpg" — file goes in the same site folder */
  { name:"Matt", wage:0, photo:"", hoursYTD:0, assignments:[] },
  { name:"Marco", wage:0, photo:"", hoursYTD:0, assignments:[] },
  { name:"Carson", wage:0, photo:"", hoursYTD:0, assignments:[] },
  { name:"Ruben", wage:0, photo:"", hoursYTD:0, assignments:[] },
  { name:"Riley", wage:0, photo:"", hoursYTD:0, assignments:[] },
  { name:"Nadav", wage:0, photo:"", hoursYTD:0, assignments:[] },
  { name:"Ismeal", wage:0, photo:"", hoursYTD:0, assignments:[] },
  { name:"Gabe", wage:0, photo:"", hoursYTD:0, assignments:[] },
  { name:"Sergio", wage:0, photo:"", hoursYTD:0, assignments:[] }
];
var selectedServices = [];

/* ---------- API layer (falls back to demo data when API_URL unset or unreachable) ---------- */
function api(action, body) {
  if (!API_URL) return demo(action, body);
  var url = API_URL + "?action=" + encodeURIComponent(action);
  var opts = body
    ? { method:"post", headers:{ "Content-Type":"text/plain;charset=utf-8" }, body: JSON.stringify(body), redirect:"follow" }
    : { method:"get", redirect:"follow" };
  return fetch(url, opts)
    .then(function(r){ return r.json(); })
    .then(function(j){ if (!j.ok) throw new Error(j.error || "API error"); return j.data; })
    .catch(function(){ toast("Live API unreachable — showing demo data"); return demo(action, body); });
}
var demoState = {
  requests: [],
  scheduled: [],
  completed: [],
  clients: [],
  hoursLog: [],
  payroll: [],
  expenses: [],
  nextId: 1,
  cfg: { fed:0, mn:0, suta:0.03, futa:0.006 }
};
function demo(action, body) {
  return new Promise(function(resolve){ setTimeout(function(){
    var s = demoState;
    switch (action) {
      case "submitQuote":
        s.requests.push({ ts:new Date().toLocaleString(), name:body.name, phone:body.phone, email:body.email,
          address:body.address, services:body.services, details:body.details, when:body.when,
          urgency:body.urgency, source:body.source, optin:!!body.optin });
        var exists=s.clients.some(function(c){ return c.name===body.name; });
        if(exists){ s.clients.forEach(function(c){ if(c.name===body.name && body.optin) c.optin=true; }); }
        else s.clients.push({ name:body.name, phone:body.phone, email:body.email, address:body.address,
          status:"One Time", source:body.source||"Other", optin:!!body.optin });
        return resolve({ received:true });
      case "submitReview":
        if(!s.reviews) s.reviews=[];
        s.reviews.unshift({ stars:body.stars, review:body.review, date:new Date().toLocaleDateString() });
        return resolve({ received:true });
      case "reviews": return resolve(s.reviews || []);
      case "login": return resolve({ ok: true }); // demo: any passcode
      case "tbq": return resolve(s.requests);
      case "tbc": return resolve(s.scheduled);
      case "done": return resolve(s.completed);
      case "clients": return resolve(s.clients);
      case "quoteJob": {
        var r = s.requests.splice(Number(body.index),1)[0]; if(!r) return resolve({ok:false});
        s.scheduled.push({ id:s.nextId++, client:r.name, phone:r.phone, email:r.email, address:r.address,
          services:r.services, details:r.details, source:r.source,
          laborEst:Number(body.labor)||0, materialsEst:Number(body.materials)||0, gasEst:Number(body.gas)||0,
          materialsList:(body.materialsList||[]),
          taxExempt:!!body.taxExempt, taxRate:Number(body.taxRate)||0.09875, scheduleDate:body.scheduleDate, crew:[], laborPaid:0,
          recurring:body.recurring||"" });
        return resolve({ok:true}); }
      case "completeJob": {
        var j=null;
        s.scheduled = s.scheduled.filter(function(x){ if(x.id===Number(body.id)){ j=x; return false; } return true; });
        if(!j) return resolve({ok:false});
        j.actualMaterials = Number(body.materials)||0;
        j.actualGas = Number(body.gas)||0;
        j.receipts = body.receipts||[];
        j.photos = body.photos||[];
        j.completedDate = new Date().toLocaleDateString();
        s.completed.unshift(j);
        if(j.recurring){
          var d=new Date(j.scheduleDate+"T12:00:00");
          if(j.recurring==="weekly") d.setDate(d.getDate()+7);
          else if(j.recurring==="biweekly") d.setDate(d.getDate()+14);
          else if(j.recurring==="monthly") d.setMonth(d.getMonth()+1);
          else if(j.recurring==="quarterly") d.setMonth(d.getMonth()+3);
          s.scheduled.push({ id:s.nextId++, client:j.client, phone:j.phone, email:j.email, address:j.address,
            services:j.services, details:j.details, source:j.source,
            laborEst:j.laborEst, materialsEst:j.materialsEst, gasEst:j.gasEst, materialsList:j.materialsList,
            taxExempt:j.taxExempt, taxRate:j.taxRate, scheduleDate:d.toISOString().slice(0,10), crew:[], laborPaid:0,
            recurring:j.recurring });
          return resolve({ok:true, recur:true, nextDate:d.toISOString().slice(0,10)});
        }
        return resolve({ok:true}); }
      case "toggleTax": {
        s.scheduled.concat(s.completed).forEach(function(j){ if(j.id===Number(body.id)) j.taxExempt=!j.taxExempt; });
        return resolve({ok:true}); }
      case "dismiss": s.requests.splice(Number(body.index),1); return resolve({ok:true});
      case "assignCrew":
        s.scheduled.concat(s.completed).forEach(function(j){ if(j.id===Number(body.jobId)){ j.crew=(j.crew||[]).concat([body.name]); } });
        CREW.forEach(function(c){ if(c.name===body.name){ c.assignments.push({ jobId:Number(body.jobId), hours:0 }); } });
        return resolve({ok:true});
      case "setWage":
        CREW.forEach(function(c){ if(c.name===body.name) c.wage=Number(body.wage)||0; });
        return resolve({ok:true});
      case "submitHours": {
        var out = { owed:0 };
        CREW.forEach(function(c){ if(c.name===body.name){
          c.assignments.forEach(function(a){ if(a.jobId===Number(body.jobId)){
            var pay = Number(body.hours) * (c.wage||0);
            a.hours = (a.hours||0) + Number(body.hours);
            c.hoursYTD = (c.hoursYTD||0) + Number(body.hours);
            out.owed = pay; } }); } });
        s.hoursLog.push({ ts:new Date(), name:body.name, jobId:Number(body.jobId), hours:Number(body.hours)||0, owed:out.owed });
        s.scheduled.concat(s.completed).forEach(function(j){ if(j.id===Number(body.jobId)){ j.laborPaid = (j.laborPaid||0) + out.owed; } });
        return resolve(out); }
      case "payroll": return resolve({ hours:s.hoursLog,
        crew:CREW.map(function(c){ return { name:c.name, wage:c.wage||0, type:"W-2 Employee" }; }),
        paid:s.payroll, cfg:s.cfg });
      case "payEmployee":
        s.payroll.push({ WeekStart:body.weekStart, Name:body.name, Hours:Number(body.hours)||0,
          Gross:Number(body.gross)||0, FedWH:Number(body.fed)||0, MNWH:Number(body.mn)||0,
          FICA:Number(body.fica)||0, Net:Number(body.net)||0, EmployerCost:Number(body.employer)||0,
          Status:"Paid", PaidDate:new Date().toLocaleDateString(), CheckNo:body.checkNo||"" });
        return resolve({ ok:true });
      case "setConfig":
        if(body.key) s.cfg[body.key]=Number(body.value)||0;
        return resolve({ ok:true });
      case "expenses": return resolve(s.expenses);
      case "addExpense":
        s.expenses.push({ ID:"EX-"+String(s.expenses.length+1).padStart(4,"0"),
          Date:body.date, Category:body.category, Vendor:body.vendor, Description:body.description,
          Amount:Number(body.amount)||0, SalesTaxPaid:Number(body.salesTax)||0,
          Deductible:body.deductible?"Yes":"No", Method:body.method });
        return resolve({ ok:true });
      case "delExpense":
        s.expenses = s.expenses.filter(function(x){ return x.ID!==body.id; });
        return resolve({ ok:true });
      default: return resolve([]);
    }
  }, 120); });
}

/* ---------- helpers ---------- */
function $(id){ return document.getElementById(id); }
function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g, function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); }
function toast(msg){ var t=$("toast"); t.textContent=msg; t.style.display="block";
  setTimeout(function(){ t.style.display="none"; }, 2600); }
function money(n){ return "$" + (Number(n)||0).toLocaleString(); }

/* ---------- customer routing ---------- */
function go(page){
  ["home","services","quote","thanks","review","rthanks","about"].forEach(function(p){
    $("page-"+p).classList.add("hidden"); });
  $("admin").classList.add("hidden"); $("site").classList.remove("hidden");
  if (page==="admin") {
    $("site").classList.add("hidden"); $("admin").classList.remove("hidden");
    $("admin-app").classList.add("hidden"); $("admin-login").style.display="flex";
    $("admin-pw").value=""; return;
  }
  $("page-"+(page==="home"?"home":page)).classList.remove("hidden");
  if(page==="review") loadReviews();
  window.scrollTo(0,0);
  return false;
}

/* ---------- customer: services ---------- */
var svcImgs = {
  "Mowing": { pair: "mowing.jpg", orient: "v" },
  "Weeding / Spraying": { pair: "weeding-spraying.jpg", orient: "v" },
  "Mulching": { pair: "mulching.jpg", orient: "h" },
  "Gutter Cleaning": { pair: "gutter-cleaning.jpg", orient: "h" },
  "Minor Tree Work": { before: "minor-tree-work-before.jpg", after: "minor-tree-work-after.jpg" },
  "Staining / Painting": { before: "staining-painting-before.jpg", after: "staining-painting-after.jpg" },
  "Power Washing": { pair: "power-washing.jpg", orient: "h" },
  "Sod / Grass Seeding": { pair: "sod-seeding.jpg", orient: "v" },
  "Window Cleaning": { pair: "window-cleaning.jpg", orient: "h" },
  "Snow Removal": { pair: "snow-removal.jpg", orient: "h" },
  "Patios / Retaining Walls": { before: "patios-walls-before.jpg", after: "patios-walls-after.jpg" },
  "Landscaping & Design": { before: "landscaping-design-before.jpg", after: "landscaping-design-after.jpg" },
  "Yard Maintenance": { before: "yard-maintenance-before.jpg", after: "yard-maintenance-after.jpg" }
};
function phFallback(img, kind){
  img.outerHTML = '<div class="ph '+(kind===1?'ph-b':'ph-a')+'">📷 '+(kind===1?'Before':'After')+' photo<br><small>coming soon</small></div>';
}
function phImg(src, alt, kind){
  return '<img src="'+src+'" alt="'+esc(alt)+'" style="width:100%;height:150px;object-fit:cover" onerror="phFallback(this,'+kind+')">';
}
/* composite before/after photo: crop one half into each slot */
function phPair(src, alt, orient, kind){
  var h = orient!=="v";
  var size = h ? "200% 100%" : "100% 200%";
  var pos = h ? (kind===1?"left":"right") : (kind===1?"top":"bottom");
  return '<div role="img" aria-label="'+esc(alt)+'" style="height:150px;background-image:url(\''+src+'\');background-size:'+size+';background-position:'+pos+';background-repeat:no-repeat;background-color:#f1f5f9"></div>';
}
function svcCard(s){
  var name = esc(s[0]);
  var imgs = svcImgs[s[0]];
  var beforeHtml = imgs.pair ? phPair(imgs.pair, name+' — before', imgs.orient, 1) : phImg(imgs.before, name+' — before', 1);
  var afterHtml = imgs.pair ? phPair(imgs.pair, name+' — after', imgs.orient, 2) : phImg(imgs.after, name+' — after', 2);
  return '<div class="card svc-card">'
    + '<div class="ph-wrap">' + beforeHtml + afterHtml + '</div>'
    + '<div style="padding:16px"><b style="font-size:17px">'+name+'</b>'
    + '<p style="color:#475569;margin:8px 0 0;font-size:14px">'+esc(s[1])+'</p></div>'
    + '</div>';
}
(function(){
  var chips=$("home-chips");
  SERVICES.slice(0,8).forEach(function(s){
    var d=document.createElement("div"); d.className="chip"; d.textContent=s[0]; chips.appendChild(d); });
  var list=$("svc-list");
  SERVICES.forEach(function(s){
    list.insertAdjacentHTML("beforeend", svcCard(s)); });
  var q=$("q-services");
  SERVICES.forEach(function(s){
    var b=document.createElement("button"); b.type="button"; b.textContent=s[0];
    b.onclick=function(){ b.classList.toggle("on");
      selectedServices = selectedServices.indexOf(s[0])<0 ? selectedServices.concat([s[0]])
        : selectedServices.filter(function(x){return x!==s[0];}); };
    q.appendChild(b); });
})();

/* ---------- customer: quote + review ---------- */
function submitQuote(e){
  e.preventDefault();
  if (!selectedServices.length) { toast("Please pick at least one service"); return false; }
  api("submitQuote", {
    name:$("q-name").value, phone:$("q-phone").value, email:$("q-email").value,
    address:$("q-address").value, services:selectedServices, details:$("q-details").value,
    when:$("q-when").value, urgency:$("q-urgency").value, source:$("q-source").value,
    optin:$("q-optin").checked
  }).then(function(){
    // booking confirmation email (real sending happens in the Apps Script backend)
    if($("q-email").value) toast("Confirmation email sent to "+$("q-email").value);
    go("thanks");
  })
    .catch(function(err){ toast("Could not send: " + err.message); });
  return false;
}
(function(){ var st=$("stars"); for(var i=1;i<=5;i++){ (function(n){
  var b=document.createElement("button"); b.textContent="★";
  b.onclick=function(){ reviewStars=n; for(var k=1;k<=5;k++) st.children[k-1].classList.toggle("on",k<=n); };
  st.appendChild(b); })(i);} })();
var reviewStars=0;
function reviewCard(r, isNew){
  var tag = isNew ? ' <span style="background:#ecfdf5;color:#047857;font-size:11px;font-weight:700;padding:2px 8px;border-radius:99px;vertical-align:middle">New</span>' : "";
  var starsOn = "", starsOff = "";
  for(var i=0;i<(r.stars||5);i++) starsOn += "★";
  for(var j=0;j<5-(r.stars||5);j++) starsOff += "★";
  var dateStr = r.date || new Date().toLocaleDateString();
  return '<div class="card" style="padding:20px;'+(isNew?'border:1px solid #047857;':'')+'">'
    + '<div style="color:#fbbf24;font-size:18px">'+starsOn+'<span style="color:#cbd5e1">'+starsOff+'</span></div>'
    + '<p style="color:#334155;margin:10px 0">"'+esc(r.review||"")+'"</p>'
    + '<small style="color:#94a3b8">MJ\'s Home Improvement customer · '+dateStr+tag+'</small>'
    + '</div>';
}
function loadReviews(){
  var list = $("review-list");
  if(!list) return;
  list.innerHTML = '<div class="card" style="padding:20px;color:#94a3b8">Loading reviews…</div>';
  api("reviews").then(function(rows){
    if(!rows || !rows.length){
      list.innerHTML = '<div class="card" style="padding:20px;color:#94a3b8">No reviews yet — be the first to leave one!</div>';
      return;
    }
    list.innerHTML = rows.map(function(r){ return reviewCard(r,false); }).join("");
  }).catch(function(){
    list.innerHTML = '<div class="card" style="padding:20px;color:#94a3b8">Reviews are unavailable right now.</div>';
  });
}
function submitReview(){
  if(!reviewStars){ toast("Please pick a star rating"); return; }
  var text = $("rev-text").value.trim();
  if(!text){ toast("Please write a few words about your experience"); return; }
  var stars = reviewStars;
  // show the new review immediately at the top of the list below
  var list = $("review-list");
  list.insertAdjacentHTML("afterbegin", reviewCard({ stars:stars, review:text }, true));
  $("rev-success").style.display = "block";
  // reset the form
  $("rev-text").value = ""; reviewStars = 0;
  var st = $("stars"); for(var k=1;k<=5;k++) st.children[k-1].classList.remove("on");
