function dkey(d){ return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0"); }
function firstOfWeek(d){ var x=new Date(d); x.setDate(x.getDate()-((x.getDay()+6)%7)); return x; }
function tbcHTML(rows){
  var byDate={}; rows.forEach(function(j){ var k=String(j.scheduleDate||""); (byDate[k]=byDate[k]||[]).push(j); });
  var html='<div class="grow" style="justify-content:space-between;margin-bottom:12px;flex-wrap:wrap">'+
    '<div><button class="btn btn-sm btn-dark" onclick="calNav(-1)">‹</button> '+
    '<b style="color:#fff;margin:0 8px">'+(calView==="month" ? monthName(calRef.getMonth())+" "+calRef.getFullYear()
      : "Week of "+firstOfWeek(calRef).toLocaleDateString())+'</b>'+
    '<button class="btn btn-sm btn-dark" onclick="calNav(1)">›</button></div>'+
    '<div><button class="btn btn-sm '+(calView==="week"?"":"btn-dark")+'" onclick="calSet(\'week\')">Week</button> '+
    '<button class="btn btn-sm '+(calView==="month"?"":"btn-dark")+'" onclick="calSet(\'month\')">Month</button> '+
    '<button class="btn btn-sm btn-dark" onclick="calSet(\'today\')">Today</button></div></div>';
  var cells=[]; var today=dkey(new Date());
  if(calView==="month"){
    var first=new Date(calRef.getFullYear(), calRef.getMonth(), 1);
    var lead=(first.getDay()+6)%7;
    var dim=new Date(calRef.getFullYear(), calRef.getMonth()+1, 0).getDate();
    var total=lead+dim; while(total%7) total++;
    for(var i=0;i<lead;i++) cells.push(null);
    for(var d=1; d<=dim; d++) cells.push(new Date(calRef.getFullYear(), calRef.getMonth(), d));
    while(cells.length<total) cells.push(null);
  } else {
    var s=firstOfWeek(calRef);
    for(var w=0; w<7; w++){ var x=new Date(s); x.setDate(s.getDate()+w); cells.push(x); }
  }
  html+='<div class="cal">'+
    ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"].map(function(d){ return '<div class="cal-head">'+d+'</div>'; }).join("");
  cells.forEach(function(d){
    if(!d){ html+='<div class="cal-cell" style="opacity:.35"></div>'; return; }
    var k=dkey(d);
    var jobs=byDate[k]||[];
    html+='<div class="cal-cell'+(k===today?" today":"")+'">'+
      '<div class="cal-num">'+d.getDate()+'</div>'+
      jobs.map(function(j){ return '<div class="cal-job" onclick="openJobDetail('+j.id+')">'+(j.recurring?'🔁 ':'')+'#'+j.id+' '+esc(j.client)+' · '+money(quotedTotal(j))+'</div>'; }).join("")+
      '</div>';
  });
  html+='</div>';
  if(!rows.length) html+='<p style="color:#94a3b8;font-size:13px;margin-top:12px">No quoted jobs waiting to be completed. Quote a request first.</p>';
  return html;
}
function calSet(v){ if(v==="today"){ calRef=new Date(); } else { calView=v; } api("tbc").then(function(rows){ $("a-content").innerHTML=tbcHTML(rows); }); }
function calNav(n){ if(calView==="month") calRef.setMonth(calRef.getMonth()+n); else calRef.setDate(calRef.getDate()+7*n); api("tbc").then(function(rows){ $("a-content").innerHTML=tbcHTML(rows); }); }
