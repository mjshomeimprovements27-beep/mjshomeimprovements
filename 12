function quotedTotal(j){ return (Number(j.laborEst)||0)+(Number(j.materialsEst)||0)+(Number(j.gasEst)||0); }
function salesTax(j){ return j.taxExempt ? 0 : quotedTotal(j)*(Number(j.taxRate)||TAX_RATE); }
function jobCosts(j){ return (Number(j.laborPaid)||0)+(Number(j.actualMaterials)||0)+(Number(j.actualGas)||0); }
function jobProfit(j){ return quotedTotal(j)-jobCosts(j); }
function monthName(n){ return ["January","February","March","April","May","June","July","August","September","October","November","December"][n]; }
